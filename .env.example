# JA Bloom362 local development
JA_BLOOM362_ENV=development
JA_BLOOM362_HOST=0.0.0.0
JA_BLOOM362_PORT=5176
JA_BLOOM362_COOKIE_SECURE=0
JA_BLOOM362_COOKIE_SAMESITE=Lax
JA_BLOOM362_SESSION_DAYS=14
JA_BLOOM362_ENABLE_DEMO_LOGIN=1
JA_BLOOM362_ENABLE_DEMO_REGISTER=1
JA_BLOOM362_SEED_DEMO=1
JA_BLOOM362_ALLOWED_ORIGINS=http://<LAN-IP>:5176,http://127.0.0.1:5176,http://localhost:5176
# Optional for closed beta:
# JA_BLOOM362_BETA_INVITE_CODE=change-this-beta-code

# Production example
# JA_BLOOM362_ENV=production
# JA_BLOOM362_HOST=127.0.0.1
# JA_BLOOM362_PORT=5176
# JA_BLOOM362_COOKIE_SECURE=1
# JA_BLOOM362_COOKIE_SAMESITE=Strict
# JA_BLOOM362_ENABLE_DEMO_LOGIN=0
# JA_BLOOM362_ENABLE_DEMO_REGISTER=0
# JA_BLOOM362_SEED_DEMO=0
# JA_BLOOM362_ALLOWED_ORIGINS=https://ja-bloom362.kz,https://www.ja-bloom362.kz
# JA_BLOOM362_BETA_INVITE_CODE=strong-private-beta-code

